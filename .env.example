# Copy to .env and fill with your Firebase config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Service account JSON (for serverless push endpoint). Set this in Vercel/GitHub Secrets, NOT in repo.
FIREBASE_SERVICE_ACCOUNT=

# (Optional) If you want the service worker to call an external push URL instead of /api/push-transaction
# VITE_FIRESTORE_PUSH_URL=
